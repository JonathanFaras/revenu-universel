# URL du projet Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Clé anon / public — utilisable dans le navigateur
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role — UNIQUEMENT côté serveur, jamais exposée au client
SUPABASE_SERVICE_ROLE_KEY=

# Optionnel : URL publique de l'app (QR codes en production)
# NEXT_PUBLIC_APP_URL=https://example.com
